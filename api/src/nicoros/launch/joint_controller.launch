<?xml version="1.0"?>
<launch>
    <arg name="json_path" default="$(find elmira)/json/nico_humanoid_upper_fixed_usb0.json" doc="Path to the JSON which describes the motors in a way PyPot understands it." />
    <arg name="dummy" default="false" doc="Run in dummy/simulation mode (no hardware required)" />
    <arg name="motion_respawn" default="true" doc="Restart Motion.py if USB/motor startup fails transiently" />
    <arg name="motion_respawn_delay" default="3.0" doc="Seconds to wait before respawning Motion.py" />
    <arg name="motion_startup_retries" default="6" doc="Motion.py hardware init attempts before process exit" />
    <arg name="motion_startup_retry_delay" default="2.0" doc="Seconds between Motion.py hardware init attempts" />
    <arg name="motion_disabled_motor_ids" default="[23, 24, 25, 26, 28, 29, 30, 32]" doc="YAML list of motor IDs to remove from PyPot startup" />
    <arg name="motion_xl320_min_safe_id" default="30" doc="Lowest XL-320 hand ID allowed on /nico/motion/xl320_cmd" />
    <arg name="motion_xl320_max_safe_id" default="60" doc="Highest XL-320 hand ID allowed on /nico/motion/xl320_cmd" />
    <arg name="joint_command_speed" default="0.03" doc="Shared JointController setAngle speed fraction" />
    
    <!-- Derived arguments for node configuration -->
    <arg name="motion_args" value="-m $(arg json_path) --vrep" if="$(arg dummy)"/>
    <arg name="motion_args" value="-m $(arg json_path)" unless="$(arg dummy)"/>
    <param name="/nico/motion/startupRetries" value="$(arg motion_startup_retries)"/>
    <param name="/nico/motion/startupRetryDelay" value="$(arg motion_startup_retry_delay)"/>
    <rosparam param="/nico/motion/disabledMotorIds" subst_value="true">$(arg motion_disabled_motor_ids)</rosparam>
    <param name="/nico/motion/xl320MinSafeId" value="$(arg motion_xl320_min_safe_id)"/>
    <param name="/nico/motion/xl320MaxSafeId" value="$(arg motion_xl320_max_safe_id)"/>
    
    <!-- Make nodes strictly required only if NOT in dummy mode (to prevent crash loops) -->
    <!-- FOR DEBUGGING: Set to false to isolate crashes -->
    <arg name="required_val" value="false"/>
    <!-- <arg name="required_val" value="false" if="$(arg dummy)"/> -->
    <!-- <arg name="required_val" value="true" unless="$(arg dummy)"/> -->

    <node name="motion" pkg="nicoros" args="$(arg motion_args)" type="Motion.py" required="$(arg required_val)" respawn="$(arg motion_respawn)" respawn_delay="$(arg motion_respawn_delay)" output="screen">
        <env name="CUDA_VISIBLE_DEVICES" value=""/>
    </node>
    
    <node name="joint_controller_left" pkg="nicoros" type="JointController.py" required="$(arg required_val)" output="screen">
        <env name="CUDA_VISIBLE_DEVICES" value=""/>
        <param name="prefix" type="string" value="left/open_manipulator_p" />
        <param name="command_speed" value="$(arg joint_command_speed)" />
    </node>
	<node name="joint_controller_right" pkg="nicoros" type="JointController.py" required="$(arg required_val)" output="screen">
        <env name="CUDA_VISIBLE_DEVICES" value=""/>
        <param name="prefix" type="string" value="right/open_manipulator_p" />
        <param name="command_speed" value="$(arg joint_command_speed)" />
    </node>
    <node name="joint_controller_head" pkg="nicoros" type="JointController.py" required="$(arg required_val)" output="screen">
        <env name="CUDA_VISIBLE_DEVICES" value=""/>
        <param name="prefix" type="string" value="NICOL/head" />
        <param name="command_speed" value="$(arg joint_command_speed)" />
    </node>

</launch>
