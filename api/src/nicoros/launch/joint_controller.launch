<?xml version="1.0"?>
<launch>
    <arg name="json_path" default="$(find elmira)/json/nico_humanoid_upper_fixed_usb0.json" doc="Path to the JSON which describes the motors in a way PyPot understands it." />
    <arg name="dummy" default="false" doc="Run in dummy/simulation mode (no hardware required)" />
    
    <!-- Derived arguments for node configuration -->
    <arg name="motion_args" value="-m $(arg json_path) --vrep" if="$(arg dummy)"/>
    <arg name="motion_args" value="-m $(arg json_path)" unless="$(arg dummy)"/>
    
    <!-- Make nodes strictly required only if NOT in dummy mode (to prevent crash loops) -->
    <!-- FOR DEBUGGING: Set to false to isolate crashes -->
    <arg name="required_val" value="false"/>
    <!-- <arg name="required_val" value="false" if="$(arg dummy)"/> -->
    <!-- <arg name="required_val" value="true" unless="$(arg dummy)"/> -->

    <node name="motion" pkg="nicoros" args="$(arg motion_args)" type="Motion.py" required="$(arg required_val)" output="screen">
        <env name="CUDA_VISIBLE_DEVICES" value=""/>
    </node>
    
    <node name="joint_controller_left" pkg="nicoros" type="JointController.py" required="$(arg required_val)" output="screen">
        <env name="CUDA_VISIBLE_DEVICES" value=""/>
        <param name="prefix" type="string" value="left/open_manipulator_p" />
    </node>
	<node name="joint_controller_right" pkg="nicoros" type="JointController.py" required="$(arg required_val)" output="screen">
        <env name="CUDA_VISIBLE_DEVICES" value=""/>
        <param name="prefix" type="string" value="right/open_manipulator_p" />
    </node>
    <node name="joint_controller_head" pkg="nicoros" type="JointController.py" required="$(arg required_val)" output="screen">
        <env name="CUDA_VISIBLE_DEVICES" value=""/>
        <param name="prefix" type="string" value="NICOL/head" />
    </node>

</launch>
