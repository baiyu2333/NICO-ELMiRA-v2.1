<launch>
  <arg name="mode" default="left"/>
  <arg name="width" default="640"/>
  <arg name="height" default="480"/>
  <arg name="framerate" default="30"/>
  <arg name="zoom" default="150"/>
  <arg name="tilt" default="-482400"/>
  <!-- Current lab setup: desktop camera app confirms NICO first-person view on /dev/video0. -->
  <arg name="device_left" default="/dev/video0"/>
  <arg name="device_right" default=""/>

  <node name="nicovision" pkg="nicoros" type="Vision.py"
    args="--mode=$(arg mode) --width=$(arg width) --height=$(arg height) --framerate=$(arg framerate) --zoom=$(arg zoom) --tilt=$(arg tilt) --device-left=$(arg device_left) --device-right=$(arg device_right)"/>
</launch>
